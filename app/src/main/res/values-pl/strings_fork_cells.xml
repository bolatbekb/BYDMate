    <string name="fork_cells_help_rule_short">Spoczynek krótszy niż 15 minut i trwające ładowanie — bez oceny.</string>
    <string name="fork_cells_help_rule_prelim">Spoczynek 15–60 minut — ocena „wstępnie”, bez czerwonego.</string>
    <string name="fork_cells_help_rule_cold">Zimno: bateria poniżej 10 °C — progi × 2, bez czerwonego, zmierz ponownie w cieple.</string>
