    <string name="fork_cells_stats_value">Здымкаў: %1$s · %2$s · з %3$s</string>
    <string name="fork_cells_stats_measures">Замеры: у спакоі — %1$d, пасля зарадкі — %2$d, пад нагрузкай — %3$d</string>
    <string name="fork_cells_stats_empty">Пакуль нічога не сабрана</string>
