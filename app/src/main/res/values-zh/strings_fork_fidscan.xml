    <string name="fork_fidscan_title">按列表记录参数</string>
    <string name="fork_fidscan_desc">用于分析：每 5 分钟读取所选列表中的参数，并将变化写入 Download 文件夹。最多 400 MB。</string>
    <string name="fork_fidscan_status">文件：%1$s · %2$d MB / %3$d MB · 读取次数：%4$d · 订阅：%5$s</string>
