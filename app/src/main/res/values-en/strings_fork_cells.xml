    <string name="fork_cells_norm_title">The norm depends on the charge and on when you measure</string>
    <string name="fork_cells_norm_zone_low">bottom</string>
    <string name="fork_cells_norm_zone_plateau">plateau: at rest</string>
    <string name="fork_cells_norm_zone_top">top: after a full charge</string>
    <string name="fork_cells_norm_upto">up to %1$d</string>
